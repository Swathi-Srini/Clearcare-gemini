{"kind":"textbox","id":"sh/hk7y1czq","slideIndex":1,"position":{"left":57.6,"top":734.4,"width":888,"height":244.8},"name":"Google Shape;103;p14","text":"WHAT WE BUILT\nTurns discharge instructions into a source-linked, multilingual care plan with review flags and calendar-ready follow-up.","geometry":"roundRect","fillColor":"#171717","lineColor":"#333333","lineWidth":1.33,"style":{"fontSize":32,"typeface":"Arial","color":"#7ED957","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/2lgfahgb","slideIndex":1,"position":{"left":974.4,"top":734.4,"width":888,"height":244.79},"name":"Google Shape;104;p14","text":"HOW AGENTIC AI IS USED\nRetrieves relevant care evidence, calls AMD only on user action, verifies the response, and routes uncertainty to human review.","geometry":"roundRect","fillColor":"#171717","lineColor":"#333333","lineWidth":1.33,"style":{"fontSize":32,"typeface":"Arial","color":"#7ED957","bold":true,"alignment":"left"}}
