{"kind":"textbox","id":"sh/6t83yd8n","slideIndex":5,"position":{"left":57.6,"top":235.2,"width":1094.4,"height":796.8},"name":"Google Shape;147;p18","text":"CLEARCARE IN USE\nOriginal wording stays beside its review status.","geometry":"roundRect","fillColor":"#171717","lineColor":"#333333","lineWidth":1.33,"style":{"fontSize":32,"typeface":"Arial","color":"#7ED957","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/dc3m5wri","slideIndex":5,"position":{"left":1180.8,"top":235.2,"width":681.6,"height":796.8},"name":"Google Shape;148;p18","text":"TECH STACK\nPDF reading: pdf.js and local deterministic extraction\nApp: JavaScript and Node.js\nAMD: Developer Cloud API, DeepSeek-V4-Flash for user-requested explanations, translation, and Care Agent answers\nVoice and calendar: browser speech APIs and .ics export\nPDF extraction does not use AI. No ROCm claim.","geometry":"roundRect","fillColor":"#171717","lineColor":"#333333","lineWidth":1.33,"style":{"fontSize":32,"typeface":"Arial","color":"#7ED957","bold":true,"alignment":"left"}}
