{"kind":"textbox","id":"sh/ypwnyd4n","slideIndex":6,"position":{"left":57.6,"top":235.2,"width":1804.79,"height":796.79},"name":"Google Shape;156;p19","text":"DATA FLOW DIAGRAM\n1  Choose PDF; extract embedded text in the browser.\n2  Parse fields with exact source evidence.\n3  Flag ambiguity, conflicts, missing units, and high-risk medicines.\n4  A user click sends selected evidence to AMD.\n5  Verify the answer; withhold unsafe output.\n6  Keep review items unscheduled; export eligible visits to .ics.\n","geometry":"roundRect","fillColor":"#171717","lineColor":"#333333","lineWidth":1.33,"style":{"fontSize":32,"typeface":"Arial","color":"#7ED957","bold":true,"alignment":"left"}}
